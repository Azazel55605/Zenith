<Project Sdk="Cosmos.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Cecil resolves enum constants relative to cwd when patching Cosmos.System. -->
    <_CosmosPatcherCommand>python3 &quot;$(MSBuildProjectDirectory)/tools/cosmos-patcher.py&quot;</_CosmosPatcherCommand>
  </PropertyGroup>

  <!-- Host-side test projects are built separately (dotnet test tests/Zenith.Tests). -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="tools/**" />
    <Compile Remove="src/Core/Input/KeyboardScanPolicy.cs" />
    <Compile Remove="src/Core/Security/Credentials.cs;src/Core/Security/PermissionPolicy.cs;src/Core/Security/FileAccessPolicy.cs;src/Core/Security/obj/**;src/Core/Security/bin/**" />
    <Compile Remove="src/Core/Network/Transport/*.cs;src/Core/Network/Transport/obj/**;src/Core/Network/Transport/bin/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <Target Name="BuildPatcherFixup" BeforeTargets="SetupPatcher">
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)/tools/PatcherFixup/PatcherFixup.csproj&quot; -c Release --nologo" />
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/tools/patcher-cache.py&quot; &quot;$(IntermediateOutputPath)/cosmos&quot;" />
  </Target>

  <Target Name="BuildZenithTls" BeforeTargets="CheckLinkCache">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/tools/build-tls.py&quot; &quot;$(IntermediateOutputPath)/cosmos/cobj&quot; --arch $(CosmosArch)" />
  </Target>

  <!-- HAL.X64 and Core.X64 have no plug targets, so the filtered patch list skips
       them. Adapt copied ILC references after SDK patching, before ILC caching;
       never modify installed packages. Core.X64 preserves IF when loading IDT. -->
  <Target Name="AdaptZenithE1000ReceiveFilter" BeforeTargets="CheckIlcCache" DependsOnTargets="RunPatcher" Condition="'$(CosmosArch)' == 'x64'">
    <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)/tools/PatcherFixup/bin/Release/net10.0/PatcherFixup.dll&quot; &quot;$(IntermediateOutputPath)/cosmos/ref/Cosmos.Kernel.Plugs.dll&quot;" />
    <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)/tools/PatcherFixup/bin/Release/net10.0/PatcherFixup.dll&quot; &quot;$(IntermediateOutputPath)/cosmos/ref/Cosmos.Kernel.HAL.X64.dll&quot;" />
    <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)/tools/PatcherFixup/bin/Release/net10.0/PatcherFixup.dll&quot; &quot;$(IntermediateOutputPath)/cosmos/ref/Cosmos.Kernel.Core.X64.dll&quot;" />
    <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)/tools/PatcherFixup/bin/Release/net10.0/PatcherFixup.dll&quot; &quot;$(IntermediateOutputPath)/cosmos/ref/Cosmos.Kernel.Core.dll&quot;" />
    <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)/tools/PatcherFixup/bin/Release/net10.0/PatcherFixup.dll&quot; &quot;$(IntermediateOutputPath)/cosmos/ref/Cosmos.Kernel.HAL.dll&quot;" />
  </Target>

  <ItemGroup>
    <AsmSearchPath Include="src/Native" />
  </ItemGroup>

  <!-- Core kernel packages -->
  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" Version="$(CosmosVersion)" />
    <PackageReference Include="Cosmos.Kernel.System" Version="$(CosmosVersion)" />
    <ProjectReference Include="src/Core/Security/Zenith.Security.csproj" />
    <ProjectReference Include="src/Core/Network/Transport/Zenith.Network.csproj" />
  </ItemGroup>

</Project>
