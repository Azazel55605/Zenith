<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Core/IO/*.cs" LinkBase="IO" />
    <Compile Include="../../src/Core/Boot/*.cs" Exclude="../../src/Core/Boot/Native*.cs" LinkBase="Boot" />
    <Compile Include="../../src/Core/Packages/*.cs" Exclude="../../src/Core/Packages/Native*.cs" LinkBase="Packages" />
    <Compile Include="../../src/Core/Processes/*.cs" Exclude="../../src/Core/Processes/Native*.cs" LinkBase="Processes" />
    <Compile Include="../../src/Core/Security/Sha256.cs" Link="Sha256.cs" />
  </ItemGroup>
</Project>
