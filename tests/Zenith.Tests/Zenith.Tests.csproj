<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host-side tests: compiles the kernel's plain-.NET sources (shell, commands, terminal
       buffer) directly, so they run under `dotnet test` without Cosmos or QEMU. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Zenith.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Download only the HAL contract assembly: do not import the Cosmos kernel build pipeline. -->
  <ItemGroup><Compile Include="../../src/Core/IO/*.cs" LinkBase="Kernel/IO" /></ItemGroup>
  <ItemGroup>
    <PackageDownload Include="Cosmos.Kernel.HAL.Interfaces" Version="[$(CosmosVersion)]" />
    <Reference Include="Cosmos.Kernel.HAL.Interfaces">
      <HintPath>$(NuGetPackageRoot)cosmos.kernel.hal.interfaces/$(CosmosVersion)/lib/net10.0/Cosmos.Kernel.HAL.Interfaces.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageDownload Include="Cosmos.Kernel.HAL" Version="[$(CosmosVersion)]" />
    <Reference Include="Cosmos.Kernel.HAL">
      <HintPath>$(NuGetPackageRoot)cosmos.kernel.hal/$(CosmosVersion)/runtimes/linux-x64/lib/net10.0/Cosmos.Kernel.HAL.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Include="../../src/Core/Storage/InstallationProfile.cs" LinkBase="Kernel/Storage" />
    <Compile Include="../../src/Core/Boot/*.cs" Exclude="../../src/Core/Boot/Native*.cs" LinkBase="Kernel/Boot" />
    <Compile Include="../../src/Core/Storage/GptChecksums.cs" LinkBase="Kernel/Storage" />
    <Compile Include="../../src/Core/Storage/GptIdentity.cs" LinkBase="Kernel/Storage" />
    <Compile Include="../../src/Core/Storage/FileSystemProbe.cs" LinkBase="Kernel/Storage" />
    <Compile Include="../../src/Core/Storage/Dev/*.cs" Exclude="../../src/Core/Storage/Dev/DevMount.cs" LinkBase="Kernel/Storage/Dev" />
    <Compile Include="../../src/Core/Storage/Ext2/*.cs" Exclude="../../src/Core/Storage/Ext2/Ext2FilesystemType.cs;../../src/Core/Storage/Ext2/RamExt2FilesystemType.cs" LinkBase="Kernel/Storage/Ext2" />
    <Compile Include="../../src/Core/Storage/Proc/ProcFilesystemType.cs" LinkBase="Kernel/Storage/Proc" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <PackageDownload Include="Cosmos.Kernel.System" Version="[$(CosmosVersion)]" />
    <Reference Include="Cosmos.Kernel.System">
      <HintPath>$(NuGetPackageRoot)cosmos.kernel.system/$(CosmosVersion)/runtimes/linux-x64/lib/net10.0/Cosmos.Kernel.System.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Include="../../src/Core/Input/GermanKeyboardLayout.cs;../../src/Core/Input/KeyboardScanPolicy.cs" LinkBase="Kernel/Input" />
    <Compile Include="../../src/Core/PowerControl.cs" Link="Kernel/PowerControl.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/Core/Shell/**/*.cs" Exclude="../../src/Core/Shell/Commands/SystemCommands.cs;../../src/Core/Shell/Commands/AccountCommands.cs;../../src/Core/Shell/Commands/ConfigurationCommands.cs;../../src/Core/Shell/Commands/PackageCommands.cs;../../src/Core/Shell/Commands/NetworkCommands.cs;../../src/Core/Shell/Commands/NativeProcessCommands.cs" LinkBase="Kernel/Shell" />
    <Compile Include="../../src/Core/Security/*.cs" Exclude="../../src/Core/Security/HardwareEntropy.cs;../../src/Core/Security/VfsSecurityPlug.cs;../../src/Core/Security/Accounts.cs;../../src/Core/Security/NativeAccessProbe.cs" LinkBase="Kernel/Security" />
    <Compile Include="../../src/Core/Configuration/*.cs" Exclude="../../src/Core/Configuration/Native*.cs;../../src/Core/Configuration/SystemConfiguration.cs" LinkBase="Kernel/Configuration" />
    <Compile Include="../../src/Core/Sessions/SessionSelection.cs" LinkBase="Kernel/Sessions" />
    <Compile Include="../../src/Core/Sessions/LoginPrompt.cs" LinkBase="Kernel/Sessions" />
    <Compile Include="../../src/Core/Console/SerialTerminal.cs" LinkBase="Kernel/Console" />
    <Compile Include="../../src/Core/Packages/*.cs" Exclude="../../src/Core/Packages/Native*.cs" LinkBase="Kernel/Packages" />
    <Compile Include="../../src/Core/Processes/*.cs" Exclude="../../src/Core/Processes/Native*.cs" LinkBase="Kernel/Processes" />
    <Compile Include="../../src/Core/Memory/*.cs" LinkBase="Kernel/Memory" />
    <Compile Include="../../src/Core/Files/*.cs" LinkBase="Kernel/Files" />
    <Compile Include="../../src/Core/Network/*.cs" Exclude="../../src/Core/Network/NetworkService.cs;../../src/Core/Network/TlsConnection.cs" LinkBase="Kernel/Network" />
    <Compile Include="../../src/Core/Network/Transport/*.cs" LinkBase="Kernel/Network/Transport" />
    <Compile Include="../../src/Core/Time/*.cs" LinkBase="Kernel/Time" />
    <Compile Include="../../src/Core/Text/*.cs" LinkBase="Kernel/Text" />
    <Compile Include="../../src/Gui/Terminal/TerminalBuffer.cs;../../src/Gui/Terminal/TerminalColors.cs;../../src/Gui/Graphics/Theme.cs;../../src/Gui/Graphics/Rect.cs;../../src/Gui/Graphics/RoundedComposition.cs;../../src/Gui/Graphics/MaterialComposition.cs;../../src/Gui/Graphics/MaterialPolicy.cs" LinkBase="Kernel/Gui" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
