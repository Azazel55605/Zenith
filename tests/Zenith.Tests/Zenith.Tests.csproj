<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host-side tests: compiles the kernel's plain-.NET sources (shell, commands, terminal
       buffer) directly, so they run under `dotnet test` without Cosmos or QEMU. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Zenith.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Download only the HAL contract assembly: do not import the Cosmos kernel build pipeline. -->
  <ItemGroup>
    <PackageDownload Include="Cosmos.Kernel.HAL" Version="[$(CosmosVersion)]" />
    <Reference Include="Cosmos.Kernel.HAL">
      <HintPath>$(NuGetPackageRoot)cosmos.kernel.hal/$(CosmosVersion)/runtimes/linux-x64/lib/net10.0/Cosmos.Kernel.HAL.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Include="../../src/Core/Storage/Dev/DevFilesystemType.cs" LinkBase="Kernel/Storage/Dev" />
    <Compile Include="../../src/Core/Storage/Proc/ProcFilesystemType.cs" LinkBase="Kernel/Storage/Proc" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/Core/Shell/**/*.cs" Exclude="../../src/Core/Shell/Commands/SystemCommands.cs" LinkBase="Kernel/Shell" />
    <Compile Include="../../src/Core/Time/*.cs" LinkBase="Kernel/Time" />
    <Compile Include="../../src/Core/Text/*.cs" LinkBase="Kernel/Text" />
    <Compile Include="../../src/Gui/Terminal/TerminalBuffer.cs;../../src/Gui/Graphics/Theme.cs" LinkBase="Kernel/Gui" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
