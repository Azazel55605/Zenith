+/* LibDOM gives the Document no owner; test containment starting at its root. */
+bool html_node_is_connected(html_content *html, dom_node *node)
+{
+	dom_element *root;
+	bool connected = false;
+	if (!node) return false;
+	if (node == (dom_node *)html->document) return true;
+	if (dom_document_get_document_element(html->document, &root) == DOM_NO_ERR && root) {
+		dom_node_contains(root, node, &connected);
+		dom_node_unref(root);
+	}
+	return connected;
+}
+
+static void html_apply_dom_changes(void *pw)
+{
+	html_content *html = pw;
+	if (html->dom_modified && html->bw && html->had_initial_layout)
+		content__reformat(&html->base, false, html->base.available_width,
+				html->base.available_height);
+}
+
+void html_dom_modified(html_content *html)
+{
+	if (html->dom_modified || html->reflowing ||
+	    (!html->layout && !html->box_conversion_context)) return;
+	html->dom_modified = true;
+	if (html->bw && html->had_initial_layout)
+		guit->misc->schedule(0, html_apply_dom_changes, html);
+}
