+dom_hubbub_error dom_hubbub_parser_enable_script(dom_hubbub_parser *parser, bool enable)
+{
+	hubbub_parser_optparams params = { .enable_scripting = enable };
+	hubbub_error err = hubbub_parser_setopt(parser->parser,
+			HUBBUB_PARSER_ENABLE_SCRIPTING, &params);
+	return err == HUBBUB_OK ? DOM_HUBBUB_OK : (DOM_HUBBUB_HUBBUB_ERR | err);
+}
