+
+bool html_page_restricts_scripts(struct hlcache_handle *h)
+{
+	html_content *html = (html_content *)hlcache_handle_get_content(h);
+	return html->script_policy_seen ||
+		llcache_handle_get_header(html->base.llcache, "Content-Security-Policy") != NULL;
+}
+
+void html_set_scripting(struct hlcache_handle *h, bool enable)
+{
+	html_content *html = (html_content *)hlcache_handle_get_content(h);
+	if (enable && html_page_restricts_scripts(h))
+		enable = false;
+	if (html->enable_scripting == enable)
+		return;
+	if (!enable) {
+		html->enable_scripting = false;
+		if (html->jsthread)
+			js_closethread(html->jsthread);
+	} else if (html->parser && dom_hubbub_parser_enable_script(html->parser, true) == DOM_HUBBUB_OK) {
+		html->enable_scripting = true;
+	}
+}
 
