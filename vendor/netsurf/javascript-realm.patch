+/* The browser's libc arena is shared with layout, images and other tabs.
+ * Track the size of each interpreter allocation without relying on libc internals. */
+enum { DOCUMENT_HEAP_LIMIT = 4 * 1024 * 1024, ALL_HEAPS_LIMIT = 10 * 1024 * 1024 };
+static size_t all_allocated;
+
+typedef union {
+	size_t size;
+	max_align_t alignment;
+} dukky_allocation;
+
+static void *dukky_realloc_function(void *udata, void *ptr, duk_size_t size)
+{
+	jsheap *heap = udata;
+	dukky_allocation *header = ptr ? (dukky_allocation *)ptr - 1 : NULL;
+	size_t old = header ? header->size : 0;
+	if (size == 0) {
+		free(header);
+		heap->allocated -= old;
+		all_allocated -= old;
+		return NULL;
+	}
+	if (size > DOCUMENT_HEAP_LIMIT - sizeof(*header))
+		return NULL;
+	size_t bytes = sizeof(*header) + size;
+	if (bytes > DOCUMENT_HEAP_LIMIT - (heap->allocated - old) ||
+			bytes > ALL_HEAPS_LIMIT - (all_allocated - old))
+		return NULL;
+	header = realloc(header, bytes);
+	if (!header)
+		return NULL;
+	header->size = bytes;
+	heap->allocated = heap->allocated - old + bytes;
+	all_allocated = all_allocated - old + bytes;
+	return header + 1;
+}
