+		return duk_error(ctx, DUK_ERR_URI_ERROR, "Invalid navigation URL");
+	enum nsurl_scheme_type scheme = nsurl_get_scheme_type(target);
+	bool allowed = scheme == NSURL_SCHEME_HTTP || scheme == NSURL_SCHEME_HTTPS ||
+			(scheme == NSURL_SCHEME_FILE && nsurl_get_scheme_type(source) == NSURL_SCHEME_FILE);
+	if (allowed)
+		browser_window_navigate(window->win, target, source,
+				flags | BW_NAVIGATE_UNVERIFIABLE, NULL, NULL, NULL);
+	nsurl_unref(target);
+	if (!allowed)
+		return duk_error(ctx, DUK_ERR_TYPE_ERROR, "Navigation scheme unavailable to scripts");
+	return 0;
+}
