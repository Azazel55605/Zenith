+/* Keep geometry in the representation used by NetSurf boxes. */
+static int flex_px(int64_t value)
+{
+	return value > INT_MAX ? INT_MAX : value < INT_MIN ? INT_MIN : (int)value;
+}
+
+static int flex_gap(const struct flex_ctx *ctx, bool row, int reference)
+{
+	css_fixed value;
+	css_unit unit;
+	uint8_t type = row ? css_computed_row_gap(ctx->flex->style, &value, &unit) :
+			css_computed_column_gap(ctx->flex->style, &value, &unit);
+	if (type != CSS_COLUMN_GAP_SET)
+		return 0;
+	if (unit == CSS_UNIT_PCT)
+		return reference > 0 ? flex_px((int64_t)value * reference / (100 * F_1)) : 0;
+	return FIXTOINT(css_unit_len2device_px(ctx->flex->style,
+			ctx->unit_len_ctx, value, unit));
+}
+
+/* Cumulative free space before entry i. Computing it from the index places
+ * the final edge exactly even when the free pixels divide unevenly. */
+static int packing_offset(uint8_t packing, int space, int i, int n)
+{
+	if (n == 0)
+		return 0;
+	switch (packing) {
+	case CSS_ALIGN_CONTENT_FLEX_END: return space;
+	case CSS_ALIGN_CONTENT_CENTER: return space / 2;
+	case CSS_ALIGN_CONTENT_SPACE_BETWEEN:
+		return space > 0 && n > 1 ? (int64_t)space * i / (n - 1) : 0;
+	case CSS_ALIGN_CONTENT_SPACE_AROUND:
+		return space > 0 ? (int64_t)space * (2LL * i + 1) / (2LL * n) : 0;
+	case CSS_ALIGN_CONTENT_SPACE_EVENLY:
+		return space > 0 ? (int64_t)space * (i + 1) / ((int64_t)n + 1) : 0;
+	default: return 0;
+	}
+}
+
+static uint8_t justify_packing(const css_computed_style *style)
+{
+	switch (css_computed_justify_content(style)) {
+	case CSS_JUSTIFY_CONTENT_FLEX_END: return CSS_ALIGN_CONTENT_FLEX_END;
+	case CSS_JUSTIFY_CONTENT_CENTER: return CSS_ALIGN_CONTENT_CENTER;
+	case CSS_JUSTIFY_CONTENT_SPACE_BETWEEN: return CSS_ALIGN_CONTENT_SPACE_BETWEEN;
+	case CSS_JUSTIFY_CONTENT_SPACE_AROUND: return CSS_ALIGN_CONTENT_SPACE_AROUND;
+	case CSS_JUSTIFY_CONTENT_SPACE_EVENLY: return CSS_ALIGN_CONTENT_SPACE_EVENLY;
+	default: return CSS_ALIGN_CONTENT_FLEX_START;
+	}
+}
 
