+/* Apply the percentage to the full viewport before rounding. Rounding a
+ * single vw to a device pixel first makes, for instance, 100vw incorrect. */
+static bool viewport_length(const css_computed_style *style, const css_unit_ctx *ctx,
+		css_fixed length, css_unit unit, css_fixed *result)
+{
+	unit = css_unit__map_viewport_units(style, ctx->viewport_height, ctx->viewport_width, unit);
+	if (unit != CSS_UNIT_VW && unit != CSS_UNIT_VH) return false;
+	css_fixed axis = unit == CSS_UNIT_VW ? ctx->viewport_width : ctx->viewport_height;
+	int64_t value = (int64_t)length * axis / F_100;
+	*result = value > INT_MAX ? INT_MAX : value < INT_MIN ? INT_MIN : (css_fixed)value;
+	return true;
 }
 
