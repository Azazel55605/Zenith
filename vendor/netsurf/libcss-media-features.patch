+/* Compare value / 1 or numerator / denominator to viewport width / height
+ * without rounding either ratio. Both fixed-point factors fit in 32 bits. */
+static inline bool mq_match_ratio(const css_mq_value *value, css_mq_feature_op op,
+		const css_media *media, bool second)
+{
+	css_mq_ratio ratio;
+	if (value->type == CSS_MQ_VALUE_TYPE_RATIO) {
+		ratio = value->data.ratio;
+	} else if (value->type == CSS_MQ_VALUE_TYPE_NUM && value->data.number >= 0) {
+		ratio = (css_mq_ratio){value->data.number, INTTOFIX(1)};
+	} else {
+		return false;
+	}
+	if ((ratio.numerator == 0 && ratio.denominator == 0) ||
+	    (media->width == 0 && media->height == 0)) return false;
+	int64_t left = (int64_t)ratio.numerator * media->height;
+	int64_t right = (int64_t)ratio.denominator * media->width;
+	int comparison = (left > right) - (left < right);
+	if (second) comparison = -comparison;
+	switch (op) {
+	case CSS_MQ_FEATURE_OP_LT: return comparison < 0;
+	case CSS_MQ_FEATURE_OP_LTE: return comparison <= 0;
+	case CSS_MQ_FEATURE_OP_EQ: return comparison == 0;
+	case CSS_MQ_FEATURE_OP_GTE: return comparison >= 0;
+	case CSS_MQ_FEATURE_OP_GT: return comparison > 0;
+	default: return false;
 	}
 }
