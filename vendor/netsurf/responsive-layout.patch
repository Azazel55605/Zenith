+/* Newly acquired handles are on object_list; the previous handles stay
+ * attached to their original boxes throughout construction and rollback. */
+void html_object_end_restyle(html_content *html, bool commit)
+{
+	struct content_html_object *drop = commit ? NULL : html->object_list;
+	struct content_html_object *keep = commit ? html->object_list : NULL;
+	while (html->old_objects) {
+		struct content_html_object *o = html->old_objects;
+		html->old_objects = o->next;
+		/* Images belong to their DOM element across display:none or a
+		 * media-dependent background change, even when uncacheable. */
+		if (!commit || o->replacement || o->box == NULL ||
+		    (o->element && o->permitted_types == CONTENT_IMAGE)) {
+			if (commit) o->box = o->replacement;
+			o->replacement = NULL;
+			o->next = keep;
+			keep = o;
+		} else {
+			o->next = drop;
+			drop = o;
+		}
+	}
+
+	html->object_list = drop;
+	for (struct content_html_object *o = drop; o; o = o->next) {
+		if (o->pending) html->base.active--;
+		if (commit && o->box && o->content && html->bw &&
+		    content_get_type(o->content) != CONTENT_NONE)
+			content_close(o->content);
+	}
+	html_object_free_objects(html);
+	html->object_list = keep;
+	html->num_objects = 0;
+	for (; keep != NULL; keep = keep->next)
+		html->num_objects++;
+}
 
