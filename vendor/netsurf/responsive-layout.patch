+/* Construct from the live DOM while the old layout and its resources remain
+ * valid. No user input or fetch callbacks can run during the synchronous swap.
+ * If construction fails, restore the old DOM bindings and resource owners. */
+bool box_restyle(html_content *c)
+{
+	dom_element *root;
+	if (dom_document_get_document_element(c->document, &root) != DOM_NO_ERR || !root)
+		return false;
+	int *arena = talloc_zero(NULL, int);
+	if (!arena) { dom_node_unref(root); return false; }
+	struct box_construct_ctx ctx = {
+		.content = c, .n = (dom_node *)root, .cb = restyle_finished,
+		.bctx = arena, .synchronous = true
+	};
+	int *old_arena = c->bctx;
+	struct box *old_layout = c->layout;
+	struct content_html_iframe *old_iframes = c->iframe;
+	struct content_html_frames *old_frameset = c->frameset;
+	colour old_background = c->background_colour;
+
+	c->old_objects = c->object_list;
+	c->object_list = NULL;
+	c->rebuilding_boxes = true;
+	c->bctx = arena;
+	c->layout = NULL;
+	c->frameset = NULL;
+	c->iframe = NULL;
+	c->background_colour = NS_TRANSPARENT;
+	convert_xml_to_box(&ctx);
+	c->rebuilding_boxes = false;
+	bool success = c->layout != NULL;
+	dom_node *focused = NULL, *selected = NULL;
+	if (success) {
+		if (c->focus_type != HTML_FOCUS_SELF)
+			focused = c->focus_owner.content->node;
+		if (c->selection_type == HTML_SELECTION_TEXTAREA || c->selection_type == HTML_SELECTION_CONTENT)
+			selected = c->selection_owner.content->node;
+	} else {
+		c->bctx = old_arena;
+		c->layout = old_layout;
+		c->iframe = old_iframes;
+		c->frameset = old_frameset;
+		c->background_colour = old_background;
+	}
+	while (ctx.bindings) {
+		struct previous_binding *b = ctx.bindings;
+		ctx.bindings = b->next;
+		if (!success) {
+			void *old;
+			dom_node_set_user_data(b->box->node, corestring_dom___ns_key_box_node_data,
+					b->box, NULL, &old);
+		} else if (b->box->scroll_x || b->box->scroll_y) {
+			struct box *next = box_for_node(b->box->node);
+			if (next && next != b->box) {
+				next->scroll_x = b->box->scroll_x;
+				next->scroll_y = b->box->scroll_y;
+				if (next->scroll_x) {
+					struct html_scrollbar_data *data = scrollbar_get_data(next->scroll_x);
+					data->box = next;
+				}
+				if (next->scroll_y) {
+					struct html_scrollbar_data *data = scrollbar_get_data(next->scroll_y);
+					data->box = next;
+				}
+				b->box->scroll_x = b->box->scroll_y = NULL;
+			}
+		}
+		talloc_free(b);
+	}
+	if (success) {
+		if (focused) {
+			struct box *b = box_for_node(focused);
+			if (b && b != c->focus_owner.content) c->focus_owner.content = b;
+			else html_set_focus(c, HTML_FOCUS_SELF,
+					(union html_focus_owner){.self = true}, true, 0, 0, 0, NULL);
+		}
+		if (selected) {
+			struct box *b = box_for_node(selected);
+			if (b && b != c->selection_owner.content) c->selection_owner.content = b;
+			else html_set_selection(c, HTML_SELECTION_NONE,
+					(union html_selection_owner){.none = true}, true);
+		}
+		if (c->drag_type != HTML_DRAG_NONE)
+			html_set_drag_type(c, HTML_DRAG_NONE,
+				(union html_drag_owner){.no_owner = true}, NULL);
+	}
+	html_object_end_restyle(c, success);
+	talloc_free(success ? old_arena : arena);
+	refresh_control_boxes(c);
+	if (success) {
+		if (c->visible_select_menu && !c->visible_select_menu->box)
+			c->visible_select_menu = NULL;
+		browser_window_rebind_iframes(c->bw);
+	}
+	return success;
+}
 
