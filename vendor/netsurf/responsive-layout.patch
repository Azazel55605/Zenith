+void browser_window_rebind_iframes(struct browser_window *bw)
+{
+	if (!bw || !bw->iframes) return;
+	for (int i = 0; i < bw->iframe_count; i++) {
+		struct browser_window *frame = bw->iframes[i];
+		frame->box = box_for_node(frame->iframe_element);
+		if (frame->box) frame->box->iframe = frame;
+	}
