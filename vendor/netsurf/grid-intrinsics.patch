+/* Grid shares the flex box construction/normalization path. */
+static inline bool lh__box_is_grid(const struct box *box)
+{
+	if (!box || !lh__box_is_flex_container(box) || !box->style) return false;
+	uint8_t display = css_computed_display_static(box->style);
+	return display == CSS_DISPLAY_GRID || display == CSS_DISPLAY_INLINE_GRID;
+}
