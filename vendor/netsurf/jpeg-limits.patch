+static void nsjpeg_read_header(j_decompress_ptr cinfo)
+{
+	jpeg_read_header(cinfo, TRUE);
+	if ((uint64_t)cinfo->image_width * cinfo->image_height > 8u * 1024u * 1024u) {
+		ERREXIT(cinfo, JERR_WIDTH_OVERFLOW);
+	}
+	/* The browser shares a 24 MiB arena with all tabs. The no-backing-store
+	 * allocator rejects progressive images that need more coefficient space. */
+	cinfo->mem->max_memory_to_use = 8L * 1024 * 1024;
+}
 
