+
+/* Duktape string offsets count UTF-16 code units, stored as CESU-8.
+ * LibDOM uses UTF-8 scalar values. BMP text is already byte-compatible. */
+static bool dukky_surrogate(const uint8_t *s, size_t n)
+{
+	return n >= 3 && s[0] == 0xed && (s[1] & 0xe0) == 0xa0 && (s[2] & 0xc0) == 0x80;
+}
+
+const char *dukky_utf8_argument(duk_context *ctx, duk_idx_t index, duk_size_t *length)
+{
+	const uint8_t *s = (const uint8_t *)duk_to_lstring(ctx, index, length);
+	size_t i = 0, used = 0, n = *length;
+	while (i < n && !dukky_surrogate(s + i, n - i)) i++;
+	if (i == n) return (const char *)s;
+	index = duk_normalize_index(ctx, index);
+	uint8_t *out = duk_push_dynamic_buffer(ctx, n);
+	memcpy(out, s, i);
+	used = i;
+	while (i < n) {
+		if (!dukky_surrogate(s + i, n - i)) {
+			out[used++] = s[i++];
+			continue;
+		}
+		if (s[i + 1] < 0xb0 && dukky_surrogate(s + i + 3, n - i - 3) && s[i + 4] >= 0xb0) {
+			uint32_t high = ((s[i + 1] & 15) << 6) | (s[i + 2] & 63);
+			uint32_t low = ((s[i + 4] & 15) << 6) | (s[i + 5] & 63);
+			uint32_t scalar = 0x10000 + (high << 10) + low;
+			out[used++] = 0xf0 | (scalar >> 18);
+			out[used++] = 0x80 | ((scalar >> 12) & 63);
+			out[used++] = 0x80 | ((scalar >> 6) & 63);
+			out[used++] = 0x80 | (scalar & 63);
+			i += 6;
+		} else {
+			memcpy(out + used, "\xef\xbf\xbd", 3); /* Unpaired surrogate. */
+			used += 3;
+			i += 3;
+		}
+	}
+	duk_resize_buffer(ctx, -1, used);
+	duk_buffer_to_string(ctx, -1);
+	duk_replace(ctx, index);
+	return duk_get_lstring(ctx, index, length);
+}
+
+static void dukky_encode_surrogate(uint8_t *out, unsigned unit)
+{
+	out[0] = 0xed;
+	out[1] = 0x80 | ((unit >> 6) & 63);
+	out[2] = 0x80 | (unit & 63);
+}
+
+void dukky_push_dom_string(duk_context *ctx, const dom_string *str)
+{
+	const uint8_t *s = (const uint8_t *)dom_string_data(str);
+	size_t n = dom_string_byte_length(str), extra = 0;
+	for (size_t i = 0; i + 3 < n; i++) {
+		if (s[i] >= 0xf0 && s[i] <= 0xf4) { extra += 2; i += 3; }
+	}
+	if (!extra) {
+		duk_push_lstring(ctx, (const char *)s, n);
+		return;
+	}
+	uint8_t *out = duk_push_fixed_buffer(ctx, n + extra);
+	size_t used = 0;
+	for (size_t i = 0; i < n; ) {
+		if (n - i >= 4 && s[i] >= 0xf0 && s[i] <= 0xf4) {
+			uint32_t scalar = ((s[i] & 7) << 18) | ((s[i + 1] & 63) << 12) |
+					((s[i + 2] & 63) << 6) | (s[i + 3] & 63);
+			scalar -= 0x10000;
+			dukky_encode_surrogate(out + used, 0xd800 | (scalar >> 10));
+			dukky_encode_surrogate(out + used + 3, 0xdc00 | (scalar & 1023));
+			used += 6;
+			i += 4;
+		} else out[used++] = s[i++];
+	}
+	duk_buffer_to_string(ctx, -1);
 }
 
