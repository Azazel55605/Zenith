+/* Execute an external classic script once. JavaScript can synchronously add
+ * another script and reallocate c->scripts, so claim the entry first. */
+static void run_external(html_content *c, struct html_script *s)
+{
+	if (s->already_started) return;
+	s->already_started = true;
+	if (!c->enable_scripting || c->aborted || !c->jsthread || !s->data.handle)
+		return;
+	if (content_get_status(s->data.handle) == CONTENT_STATUS_DONE &&
+	    content_get_type(s->data.handle) == CONTENT_JS) {
+		size_t size;
+		const uint8_t *data = content_get_source_data(s->data.handle, &size);
+		js_exec(c->jsthread, data, size, nsurl_access(hlcache_handle_get_url(s->data.handle)));
+	}
+}
+
+void html_run_deferred_scripts(html_content *c)
+{
+	/* Initial conversion waits for every parser-blocking and deferred
+	 * response. A failed response counts as settled and is skipped. */
+	for (unsigned i = 0; i < c->scripts_count; i++) {
+		if (c->scripts[i].type == HTML_SCRIPT_DEFER)
+			run_external(c, &c->scripts[i]);
+	}
 }
 
