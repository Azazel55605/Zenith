+/* A reflow may replace every box, including inline text fragments. Rebuild
+ * the set of matches before it can be used for another Find or redraw. */
+void content_textsearch_reformat(struct content *c)
+{
+	struct textsearch_context *ctx = c->textsearch.context;
+	if (!ctx || ctx->newsearch || !c->textsearch.string) return;
+	size_t ordinal = 0;
+	for (struct list_entry *p = ctx->current; p && p->prev; p = p->prev)
+		ordinal++;
+	search_flags_t flags = (ctx->prev_case_sens ? SEARCH_FLAG_CASE_SENSITIVE : 0) |
+			(ctx->show_all ? SEARCH_FLAG_SHOWALL : 0);
+	search_text(ctx, c->textsearch.string, strlen(c->textsearch.string), flags, &ordinal);
+}
